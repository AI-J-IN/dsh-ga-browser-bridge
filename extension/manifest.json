{
  "manifest_version": 3,
  "name": "DSH Browser Bridge",
  "version": "0.1.0",
  "description": "Drives the current Chrome tab through chrome.debugger and dials out to the local DSH Browser Bridge plugin over WebSocket.",
  "permissions": ["tabs", "debugger", "storage", "cookies", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Browser Bridge",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "128": "icon128.png"
  },
  "minimum_chrome_version": "116"
}
